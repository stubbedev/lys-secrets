%global debug_package %{nil}
%global _build_id_links none

Name:           lys-secrets
Version:        @VERSION@
Release:        1%{?dist}
Summary:        freedesktop Secret Service for the lys desktop
License:        MIT AND BSD-2-Clause AND BSD-3-Clause
URL:            https://github.com/stubbedev/lys-secrets
Source0:        https://github.com/stubbedev/lys-secrets/releases/download/v%{version}/lys-secrets-%{version}-%{_arch}-linux.tar.gz
ExclusiveArch:  x86_64

BuildRequires:  systemd-rpm-macros

%description
lys-secrets serves org.freedesktop.secrets: libsecret, Chromium and Electron apps, git's credential helper and the portal's Secret backend keep their secrets in collections encrypted at rest.

The package activates nothing by itself, since gnome-keyring may claim the same name: enable the user unit with systemctl --user enable --now lys-secrets. The D-Bus activation files are installed as a reference under %{_datadir}/lys-secrets.

%prep
%setup -q -n lys-secrets-%{version}-%{_arch}-linux

%build

%install
install -d %{buildroot}%{_bindir}
install -m 0755 lys-secrets %{buildroot}%{_bindir}/

install -d %{buildroot}%{_userunitdir}
install -m 0644 lys-secrets.service %{buildroot}%{_userunitdir}/

install -d %{buildroot}%{_datadir}/lys-secrets
install -m 0644 org.freedesktop.secrets.service dev.stubbe.lys.Vault1.service %{buildroot}%{_datadir}/lys-secrets/

%files
%license LICENSE
%{_bindir}/lys-secrets
%{_userunitdir}/lys-secrets.service
%dir %{_datadir}/lys-secrets
%{_datadir}/lys-secrets/org.freedesktop.secrets.service
%{_datadir}/lys-secrets/dev.stubbe.lys.Vault1.service

%changelog
* @DATE@ @MAINTAINER@ - @VERSION@-1
- Packaged upstream binary release
