[Unit]
Description=lys-secrets Secret Service provider and Bitwarden vault
# It serves the Bitwarden vault (dev.stubbe.lys.Vault1) always, and
# org.freedesktop.secrets unless another provider, such as
# gnome-keyring, already owns that name.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=dev.stubbe.lys.Vault1
ExecStart=/usr/bin/lys-secrets
Restart=on-failure
RestartSec=3
Slice=session.slice

[Install]
WantedBy=graphical-session.target
